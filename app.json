{
  "expo": {
    "name": "Ani-Grow",
    "slug": "anigrow-ui",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/anigrow_app_icon.png",
    "scheme": "anigrowui",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anigrow.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/branding/anigrow_app_icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "AniGrow needs access to your photo library to attach images to AniBot.",
          "cameraPermission": "AniGrow needs access to your camera to take photos for AniBot."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "AniGrow needs access to your microphone so you can send voice messages to AniBot."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#16A34A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9f63da9-5c3a-4470-b29b-22da47f29758"
      }
    }
  }
}
